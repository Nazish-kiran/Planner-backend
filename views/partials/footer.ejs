<!-- Footer Section -->
<% var loggedin = typeof loggedin !== 'undefined' ? loggedin : true; %> 
<% if (loggedin) { %>
<footer class="bg-[#7c3aed] text-white py-6 mt-10">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <!-- Left Section: Text or Links -->
      <div class="flex flex-col items-center md:items-start">
        <h1 class="text-[22px] font-bold"><i class="fa-regular fa-calendar" style="color:#E53935;"></i> BMI 5‑Year Planner</h1>
        <p class="mt-2">Your one-stop shop for all your tasks</p>
      </div>

      <!-- Middle Section: Social Icons -->
      <div class="mt-4 md:mt-0 flex space-x-4">
        <a href="#" class="text-white hover:text-gray-400"><i class="ri-facebook-line text-2xl"></i></a>
        <a href="#" class="text-white hover:text-gray-400"><i class="ri-twitter-line text-2xl"></i></a>
        <a href="#" class="text-white hover:text-gray-400"><i class="ri-instagram-line text-2xl"></i></a>
        <a href="#" class="text-white hover:text-gray-400"><i class="ri-linkedin-line text-2xl"></i></a>
