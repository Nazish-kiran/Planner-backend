<%- include('./partials/header') %>

<div class="flex items-center justify-center min-h-screen bg-zinc-900 text-white">
  <div class="w-full max-w-2xl p-8 bg-zinc-800 rounded-lg shadow-lg">
    <h1 class="text-3xl font-bold mb-4">Welcome, </h1>
    <p class="text-lg text-zinc-300 mb-6">
      You’re logged in with <span class="font-semibold text-blue-400"></span>.
    </p>

    <div class="grid gap-4 md:grid-cols-2">
      <!-- Card 1 -->
      <div class="bg-zinc-700 rounded-lg p-4 shadow hover:shadow-lg transition">
        <h2 class="text-xl font-semibold mb-2">Your Profile</h2>
        <p class="text-zinc-300">Manage your account settings and details.</p>
      </div>

      <!-- Card 2 -->
      <div class="bg-zinc-700 rounded-lg p-4 shadow hover:shadow-lg transition">
        <h2 class="text-xl font-semibold mb-2">Dashboard</h2>
        <p class="text-zinc-300">Access your main features and tools here.</p>
      </div>
    </div>

    <form action="/users/logout" method="post" class="mt-6">
      <button 
        type="submit" 
        class="w-full py-2 bg-red-600 rounded hover:bg-red-700 transition-colors"
      >
        Logout
      </button>
    </form>
  </div>
</div>

<%- include('./partials/footer') %>
