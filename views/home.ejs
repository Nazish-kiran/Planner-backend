<%- include('./partials/header') %>

<!-- Hero Section -->
<section class="gradient-bg relative overflow-hidden">
  <div class="hero-gradient absolute inset-0 z-0"></div>
  <div
    class="container mx-auto px-6 py-24 flex flex-col items-center justify-center text-center relative z-10"
  >
    <div class="max-w-4xl">
      <h1 class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight">
        Master Your <span class="text-brand">5-Year Plan</span>
      </h1>
      <p
        class="text-xl md:text-2xl text-zinc-300 max-w-3xl mb-10 leading-relaxed"
      >
        Transform your long-term vision into actionable steps. Stay consistent,
        track your goals, and build your future with the BMI Planner's
        intelligent progress tracking system.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/home"
          class="px-10 py-4 rounded-xl bg-brand hover:bg-violet-700 transition-all font-semibold text-lg shadow-lg hover:shadow-xl flex items-center"
        >
          Start Your Journey <i class="fas fa-arrow-right ml-2"></i>
        </a>
        <a
          href="#features"
          class="px-10 py-4 rounded-xl bg-zinc-800 hover:bg-zinc-700 transition-all font-semibold text-lg border border-zinc-700"
        >
          Learn More
        </a>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-20 max-w-4xl">
      <div class="text-center">
        <div class="stats-counter" id="users-counter">0</div>
        <p class="text-zinc-400">Active Users</p>
      </div>
      <div class="text-center">
        <div class="stats-counter" id="goals-counter">0</div>
        <p class="text-zinc-400">Goals Achieved</p>
      </div>
      <div class="text-center">
        <div class="stats-counter" id="plans-counter">0</div>
        <p class="text-zinc-400">5-Year Plans</p>
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section id="features" class="py-20 px-6">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-4">
        Powerful Features for Your Success
      </h2>
      <p class="text-xl text-zinc-400 max-w-3xl mx-auto">
        Our comprehensive toolkit helps you break down ambitious goals into
        manageable steps with precision tracking.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Feature 1 -->
      <div class="bg-zinc-800 rounded-xl p-6 card-hover border border-zinc-700">
        <div class="feature-icon">
          <i class="fas fa-bullseye text-2xl text-brand"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Goal Breakdown</h3>
        <p class="text-zinc-400">
          Deconstruct your 5-year vision into quarterly milestones, monthly
          targets, and weekly actions for maximum clarity.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="bg-zinc-800 rounded-xl p-6 card-hover border border-zinc-700">
        <div class="feature-icon">
          <i class="fas fa-chart-line text-2xl text-brand"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Progress Analytics</h3>
        <p class="text-zinc-400">
          Visualize your advancement with detailed charts and insights to stay
          motivated and adjust your strategy.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="bg-zinc-800 rounded-xl p-6 card-hover border border-zinc-700">
        <div class="feature-icon">
          <i class="fas fa-bell text-2xl text-brand"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Smart Reminders</h3>
        <p class="text-zinc-400">
          Never miss a deadline with customizable notifications that keep you on
          track without overwhelming you.
        </p>
      </div>

      <!-- Feature 4 -->
      <div class="bg-zinc-800 rounded-xl p-6 card-hover border border-zinc-700">
        <div class="feature-icon">
          <i class="fas fa-sync-alt text-2xl text-brand"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Habit Tracking</h3>
        <p class="text-zinc-400">
          Build consistency with daily habit tracking that connects your
          routines to long-term success.
        </p>
      </div>

      <!-- Feature 5 -->
      <div class="bg-zinc-800 rounded-xl p-6 card-hover border border-zinc-700">
        <div class="feature-icon">
          <i class="fas fa-users text-2xl text-brand"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Collaboration</h3>
        <p class="text-zinc-400">
          Share plans with mentors or team members for accountability and
          collective goal achievement.
        </p>
      </div>

      <!-- Feature 6 -->
      <div class="bg-zinc-800 rounded-xl p-6 card-hover border border-zinc-700">
        <div class="feature-icon">
          <i class="fas fa-mobile-alt text-2xl text-brand"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Mobile Access</h3>
        <p class="text-zinc-400">
          Access your plan anywhere with our responsive web app and dedicated
          mobile applications.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- About Author Section -->
<section class="py-16 px-6 bg-zinc-800">
<div class="container mx-auto max-w-4xl">
    <h2 class="text-4xl font-bold mb-12 text-center">About Our Team</h2>

    <div class="flex flex-col md:flex-row gap-8 items-center mb-12">
      <div class="md:w-1/3 flex justify-center">
        <div
          class="w-48 h-48 rounded-full bg-gradient-to-br from-brand to-violet-900 flex items-center justify-center"
        >
          <i class="fas fa-users text-6xl text-white"></i>
        </div>
      </div>
      <div class="md:w-2/3">
        <h3 class="text-2xl font-bold mb-4">
          Student Innovators: Passionate About Productivity
        </h3>
        <p class="text-zinc-300 mb-4">
          We're a team of three dedicated students <span class="text-[#7c3aed]">Sufiyan Rajput</span>, <span class="text-[#7c3aed]">Nazish Kiran</span>, and <span class="text-[#7c3aed]">Nevvera Naeem</span> who combined our skills in development, design, and user experience to create the BMI 5-Year Planner.
        </p>
        <p class="text-zinc-300">
          As students ourselves, we understand the challenges of balancing academic goals, personal growth, and long-term planning. We created this tool to help ourselves and others navigate these challenges more effectively.
        </p>
      </div>
    </div>

    <div id="accordion" class="space-y-4">
      <!-- Item 1 -->
      <div class="border border-zinc-700 rounded-xl overflow-hidden">
        <button
          class="w-full flex justify-between items-center p-6 bg-zinc-900 hover:bg-zinc-800 transition-all text-left"
          onclick="toggleAccordion(1)"
        >
          <span class="font-semibold text-lg"
            >Our Inspiration & Mission</span
          >
          <i
            id="icon-1"
            class="fas fa-chevron-down transition-transform accordion-icon"
          ></i>
        </button>
        <div id="content-1" class="accordion-content">
          <div class="p-6 text-zinc-300 bg-zinc-900 border-t border-zinc-800">
            <p class="mb-4">
              The <span class="text-[#7c3aed]">BMI Planner</span> was born from our own struggles with long-term planning as students. We noticed that while we had big dreams and academic goals, we lacked a systematic approach to turn these aspirations into actionable steps.
            </p>
            <p>
              Our mission is to help students and young professionals bridge the gap between ambition and execution. We believe that with the right tools and systematic approach, anyone can make consistent progress toward their most important life goals.
            </p>
          </div>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="border border-zinc-700 rounded-xl overflow-hidden">
        <button
          class="w-full flex justify-between items-center p-6 bg-zinc-900 hover:bg-zinc-800 transition-all text-left"
          onclick="toggleAccordion(2)"
        >
          <span class="font-semibold text-lg"
            >What Makes Our Approach Unique</span
          >
          <i
            id="icon-2"
            class="fas fa-chevron-down transition-transform accordion-icon"
          ></i>
        </button>
        <div id="content-2" class="accordion-content">
          <div class="p-6 text-zinc-300 bg-zinc-900 border-t border-zinc-800">
            <p class="mb-4">
              Unlike complex productivity tools designed for corporate environments, we built the <span class="text-[#7c3aed]">BMI Planner</span> specifically with students and young professionals in mind. We focused on simplicity, visual progress tracking, and flexibility to adapt to changing goals.
            </p>
            <p>
              Our fresh perspective as students allows us to understand the unique challenges of balancing multiple priorities—academics, personal development, career planning, and social life—all while maintaining motivation over the long term.
            </p>
          </div>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="border border-zinc-700 rounded-xl overflow-hidden">
        <button
          class="w-full flex justify-between items-center p-6 bg-zinc-900 hover:bg-zinc-800 transition-all text-left"
          onclick="toggleAccordion(3)"
        >
          <span class="font-semibold text-lg"
            >Our Development Philosophy</span
          >
          <i
            id="icon-3"
            class="fas fa-chevron-down transition-transform accordion-icon"
          ></i>
        </button>
        <div id="content-3" class="accordion-content">
          <div class="p-6 text-zinc-300 bg-zinc-900 border-t border-zinc-800">
            <p class="mb-4">
              As student developers, we believe in creating tools that are both powerful and accessible. We've incorporated research-backed planning methodologies while ensuring the interface remains intuitive and user-friendly.
            </p>
            <p>
              We're committed to continuous improvement based on user feedback. As we continue our academic journeys, we plan to enhance the <span class="text-[#7c3aed]">BMI Planner</span> with features that address the evolving needs of students and young professionals navigating their career paths.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

